            {
              "options": {
                "0": { "color": "green",  "index": 0, "text": "✅ INFO"      },
                "1": { "color": "orange", "index": 1, "text": "⚠️ WARNING"   },
                "2": { "color": "red",    "index": 2, "text": "🚨 CRITICAL"  }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red",    "value": 2 }
            ]
